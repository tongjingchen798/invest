<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="io.renren.modules.projecttype.dao.ProjectTypeDao">

    <resultMap type="io.renren.modules.projecttype.entity.ProjectTypeEntity" id="projectTypeMap">
        <result property="typeId" column="type_id"/>
        <result property="typeName" column="type_name"/>
        <result property="sort" column="sort"/>
        <result property="status" column="status"/>
        <result property="createDate" column="create_date"/>
        <result property="updateDate" column="update_date"/>
        <result property="sysCreateUserId" column="sys_create_user_id"/>
        <result property="sysUpdateUserId" column="sys_update_user_id"/>
    </resultMap>

    <!-- 根据ID查询 -->
    <select id="selectById" resultMap="projectTypeMap">
        SELECT * FROM tb_project_type WHERE type_id = #{id}
    </select>

    <!-- 查询列表 -->
    <select id="selectList" resultMap="projectTypeMap">
        SELECT * FROM tb_project_type
        <where>
            <if test="typeName != null and typeName != ''">
                AND type_name LIKE CONCAT('%', #{typeName}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY sort ASC, create_date DESC
    </select>

    <!-- 分页查询 -->
    <select id="selectPage" resultMap="projectTypeMap">
        SELECT * FROM tb_project_type
        <where>
            <if test="typeName != null and typeName != ''">
                AND type_name LIKE CONCAT('%', #{typeName}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY sort ASC, create_date DESC
    </select>

    <!-- 统计总数 -->
    <select id="selectCount" resultType="int">
        SELECT COUNT(*) FROM tb_project_type
        <where>
            <if test="typeName != null and typeName != ''">
                AND type_name LIKE CONCAT('%', #{typeName}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </select>

    <!-- 插入 -->
    <insert id="insert" parameterType="io.renren.modules.projecttype.entity.ProjectTypeEntity" useGeneratedKeys="true" keyProperty="typeId">
        INSERT INTO tb_project_type (
            type_name, sort, status, create_date, update_date, sys_create_user_id, sys_update_user_id
        ) VALUES (
            #{typeName}, #{sort}, #{status}, #{createDate}, #{updateDate}, #{sysCreateUserId}, #{sysUpdateUserId}
        )
    </insert>

    <!-- 更新 -->
    <update id="updateById" parameterType="io.renren.modules.projecttype.entity.ProjectTypeEntity">
        UPDATE tb_project_type SET
            type_name = #{typeName},
            sort = #{sort},
            status = #{status},
            update_date = #{updateDate},
            sys_update_user_id = #{sysUpdateUserId}
        WHERE type_id = #{typeId}
    </update>

    <!-- 删除 -->
    <delete id="deleteById">
        DELETE FROM tb_project_type WHERE type_id = #{id}
    </delete>

    <!-- 批量删除 -->
    <delete id="deleteBatchIds">
        DELETE FROM tb_project_type WHERE type_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
